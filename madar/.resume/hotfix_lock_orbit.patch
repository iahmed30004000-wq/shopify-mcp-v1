+  }
+  await tester.pump();
+}
+
+Future<void> _return(WidgetTester tester) async {
+  for (final s in [AppLifecycleState.hidden, AppLifecycleState.inactive, AppLifecycleState.resumed]) {
+    tester.binding.handleAppLifecycleStateChanged(s);
+  }
+  await tester.pump();
