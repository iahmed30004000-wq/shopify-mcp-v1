<?xml version="1.0" encoding="utf-8"?>
<!-- The Top 3 widget in the widget picker of Android 8–11 (previewImage;
     Android 12+ shows @layout/widget_preview_tasks): the 4×2 card as a
     wireframe – title and count, the "to go" line, one item done, two
     open. Colours follow light / dark mode. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="250dp"
    android:height="120dp"
    android:viewportWidth="250"
    android:viewportHeight="120">
    <!-- Card -->
    <path
        android:fillColor="@color/widget_surface"
        android:strokeColor="@color/widget_stroke"
        android:strokeWidth="1"
        android:pathData="M22,0.5H228A21.5,21.5 0 0,1 249.5,22V98A21.5,21.5 0 0,1 228,119.5H22A21.5,21.5 0 0,1 0.5,98V22A21.5,21.5 0 0,1 22,0.5Z" />
    <!-- Title, count -->
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M19,13H91A5,5 0 0,1 91,23H19A5,5 0 0,1 19,13Z" />
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M214,13H231A5,5 0 0,1 231,23H214A5,5 0 0,1 214,13Z" />
    <!-- "2 to go" -->
    <path
        android:fillColor="@color/widget_text_secondary"
        android:pathData="M17.5,30H55.5A3.5,3.5 0 0,1 55.5,37H17.5A3.5,3.5 0 0,1 17.5,30Z" />
    <!-- Done (muted, struck through) -->
    <path
        android:strokeColor="@color/widget_text_muted"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M15,53.5L18.5,57L25,50 M34,54H122" />
    <!-- Two open -->
    <path
        android:strokeColor="@color/widget_accent"
        android:strokeWidth="1.8"
        android:fillColor="#00000000"
        android:pathData="M20,69a5,5 0 1,0 0,10a5,5 0 1,0 0,-10Z M20,91a5,5 0 1,0 0,10a5,5 0 1,0 0,-10Z" />
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M36,71H150A3,3 0 0,1 150,77H36A3,3 0 0,1 36,71Z M36,93H168A3,3 0 0,1 168,99H36A3,3 0 0,1 36,93Z" />
</vector>
