    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,0.8a11.2,11.2 0 1,0 0,22.4a11.2,11.2 0 1,0 0,-22.4Z M12,2.4a9.6,9.6 0 1,1 0,19.2a9.6,9.6 0 1,1 0,-19.2Z" />
