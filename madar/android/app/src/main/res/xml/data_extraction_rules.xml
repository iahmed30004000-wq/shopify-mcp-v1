<?xml version="1.0" encoding="utf-8"?>
<!--
  Madar never leaves the device through Android backup or device-to-device
  transfer (API 31+). The database (files/madar.db) is SQLCipher-encrypted
  with a key wrapped by an Android Keystore key, and Keystore keys are never
  migrated: copying the file, the flutter_secure_storage prefs or the
  onboarding flag to a new device would leave an app that can never unlock
  its data. Moving data happens only through Madar's own export / import.

  android:allowBackup="false" / fullBackupContent="false" still cover
  API 30 and below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
