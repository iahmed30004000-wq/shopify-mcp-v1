<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the next-prayer widget (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_astro_preview" />

    <TextView
        style="@style/widget_text_headline"
        android:gravity="center"
        android:text="@string/widget_sample_prayer"
        android:textSize="18sp" />

    <TextView
        style="@style/widget_text_detail"
        android:gravity="center"
        android:text="@string/widget_sample_prayer_time" />

    <TextView
        style="@style/widget_text_accent"
        android:gravity="center"
        android:text="@string/widget_sample_countdown"
        android:textSize="12sp" />
</LinearLayout>
