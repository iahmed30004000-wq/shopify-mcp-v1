<?xml version="1.0" encoding="utf-8"?>
<!-- Next prayer, 2×2: the astrolabe over the prayer's name, time and the
     ticking countdown. Centred, so it reads the same in both directions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/widget_astro_day"
            style="@style/widget_astro_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_astro_preview" />

        <ImageView
            android:id="@+id/widget_astro_night"
            style="@style/widget_astro_night"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_astro_preview" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_headline"
        style="@style/widget_text_headline"
        android:gravity="center"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_detail"
        style="@style/widget_text_detail"
        android:gravity="center" />

    <Chronometer
        android:id="@+id/widget_countdown"
        style="@style/widget_text_accent"
        android:gravity="center"
        android:textSize="12sp" />
</LinearLayout>
